sort Class; const perishable, hazardous: Class;
relation classes(c: Class); classes(perishable); classes(hazardous);
input declared(c: Class) within classes;
input docked(); input priority_call();
assumption one_class: at_most_one(declared, group_by: ());

relation reefer_booked(); reefer_booked() :- slot_open();
relation reefer_requested(); reefer_requested() :- !declared(hazardous), priority_call();
relation slot_open();
slot_open() :- declared(perishable), cleared();
slot_open() :- reefer_requested(), cleared();
relation claim_fails();   claim_fails()   :- docked(), !reefer_booked();
relation hazard_claim();  hazard_claim()  :- declared(hazardous), !claim_fails();
relation inspected();     inspected()     :- declared(perishable);
                          inspected()     :- hazard_claim();
relation held();          held()          :- priority_call(), inspected();
relation cleared();       cleared()       :- docked(), !held();
notice cleared_varies: varies(cleared);
verification v { assumptions: [one_class]; obligations: []; notices: [cleared_varies]; }
