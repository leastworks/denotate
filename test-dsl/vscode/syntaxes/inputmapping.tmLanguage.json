{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "InputMapping",
  "scopeName": "source.inputmapping",
  "patterns": [
    { "name": "comment.line.double-slash.inputmapping", "match": "//[^\\r\\n]*" },
    { "name": "keyword.declaration.inputmapping", "match": "\\b(input|slot)\\b" },
    { "name": "keyword.control.inputmapping", "match": "\\b(mask|when)\\b" },
    { "name": "keyword.operator.logical.inputmapping", "match": "\\b(and|or|not|is)\\b" },
    { "name": "support.function.inputmapping", "match": "\\b(available|present|input_value|slot_value)\\b" },
    { "name": "constant.numeric.integer.inputmapping", "match": "-?[0-9]+" },
    { "name": "keyword.operator.assignment.inputmapping", "match": "<-" },
    { "name": "punctuation.separator.inputmapping", "match": "[,;]" }
  ]
}
