{
  "name": "denotate",
  "displayName": "Denotate",
  "description": "Denotate .den editor: checking, navigation and origins",
  "version": "0.0.1",
  "license": "Apache-2.0",
  "publisher": "denotate",
  "private": true,
  "engines": {"node": ">=22.0.0", "vscode": "^1.141.0"},
  "categories": ["Programming Languages"],
  "main": "./dist/extension.cjs",
  "activationEvents": ["onLanguage:denotate", "workspaceContains:**/den.root"],
  "contributes": {
    "configuration": {
      "title": "Denotate",
      "properties": {
        "denotate.showLibraryRewrites": {
          "type": "boolean", "default": true, "scope": "window",
          "description": "Show rewrite warnings for library rules in consuming programs. The library's own warnings, other diagnostics and full status summaries remain available."
        }
      }
    },
    "languages": [{"id": "denotate", "aliases": ["Denotate IR"], "extensions": [".den"], "configuration": "./dist/language-configuration.json"}],
    "grammars": [{"language": "denotate", "scopeName": "source.denotate", "path": "./dist/denotate.tmLanguage.json"}],
    "menus": {"editor/context": [{"command": "denotate.goToOrigin", "when": "editorLangId == denotate", "group": "navigation"}]},
    "commands": [
      {"command": "denotate.showOutput", "title": "Denotate: Show Output"},
      {"command": "denotate.goToOrigin", "title": "Denotate: Go to Origin", "enablement": "editorLangId == denotate"},
      {"command": "denotate.createRoot", "title": "Denotate: Create den.root here"}
    ]
  },
  "scripts": {
    "generate": "node scripts/generate-parser.mjs",
    "test:setup": "node --test ../../scripts/tests/*.test.mjs",
    "test:generation": "node --test tests/parser-generation.test.mjs",
    "test:progress": "node --test tests/checking-progress.test.cjs",
    "prebuild": "node ../../scripts/ensure-editor-deps.mjs den",
    "build": "npm run generate && cargo +1.93.0 build --manifest-path ../../Cargo.toml --locked -p denotate-lsp --release && node build.mjs",
    "test": "npm run test:setup && npm run test:generation && npm run test:progress && npm run generate && cargo +1.93.0 test --manifest-path ../../Cargo.toml --locked -p denotate-lsp",
    "test:origins": "node --test tests/origin-navigation.cjs",
    "test:lsp": "npm run build && node scripts/test-lsp.mjs",
    "test:vscode": "npm run build && node scripts/run-vscode-smoke.mjs"
  },
  "dependencies": {"vscode-languageclient": "10.1.2"},
  "devDependencies": {"tree-sitter-cli": "0.25.10", "esbuild": "0.25.12", "@vscode/test-electron": "2.5.2"}
}
