// The library verification checks these mappings with one_present_input.
// The app verification below also checks them with unrestricted inputs.
namespace mappings;
use library;

const i, j: Input;
const a: Slot;

mapped_to(i, a);
mapped_to(j, a);

verification unrestricted_inputs {
    assumptions: [];
    obligations: [library::one_input_per_slot];
}
