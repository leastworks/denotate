namespace shipping;
relation inbound_mapping(field: Field, element: Element);
relation outbound_mapping(element: Element, field: Field);
relation mapping_endpoints(field: Field, element: Element);
mapping_endpoints(F, E) :- inbound_mapping(F, E);
mapping_endpoints(F, E) :- outbound_mapping(E, F);
relation same_type(field: Field, element: Element);
same_type(F, E) :- field_type(F, T), element_type(E, T);
relation invalid_mapping(field: Field, element: Element);
invalid_mapping(F, E) :- mapping_endpoints(F, E), !same_type(F, E);
obligation no_invalid_mappings: empty(invalid_mapping)
    message "A direct mapping needs matching endpoint types.";
verification mapping_types {
    assumptions: [];
    obligations: [no_invalid_mappings];
}
