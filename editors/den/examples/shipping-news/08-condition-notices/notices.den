use shipping;
namespace authoring {
    // Downstream observations: these do not define terms or mapping guards.
    relation customs();
    customs() :- toggle_active(options::'customs-checks');
    relation express();
    express() :- toggle_active(options::'express-service');
    relation enclosing();
    enclosing() :- customs(), express();
    relation not_customs();
    not_customs() :- !toggle_active(options::'customs-checks');
    relation unreachable();
    unreachable() :- enclosing(), not_customs();
    notice outer_customs_guard_varies: varies(customs);
    notice nested_express_guard_varies: varies(express, within: customs);
    // A deeper condition must retain BOTH ancestors, not only express.
    notice nested_customs_guard_varies: varies(customs, within: enclosing);
    notice nested_not_customs_guard_varies: varies(not_customs, within: enclosing);
    notice inner_express_guard_varies: varies(express, within: unreachable);
    verification conditions {
        assumptions: [one_field_value, one_element_value, predicate_contracts];
        obligations: [];
        notices: [outer_customs_guard_varies, nested_express_guard_varies,
            nested_customs_guard_varies, nested_not_customs_guard_varies,
            inner_express_guard_varies];
    }
}
