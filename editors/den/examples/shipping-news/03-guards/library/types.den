// Shipping News library. DataType values are vocabulary, not separate IR sorts.
namespace shipping;
sort DataType;
const number, text: DataType;
sort Field;
sort Element;
relation field_type(field: Field, type: DataType);
relation element_type(element: Element, type: DataType);
obligation exactly_one_type_per_field: exactly_one(field_type, group_by: field)
    message "Each message field needs exactly one type.";
obligation exactly_one_type_per_element: exactly_one(element_type, group_by: element)
    message "Each shipment element needs exactly one type.";
verification declarations {
    assumptions: [];
    obligations: [exactly_one_type_per_field, exactly_one_type_per_element];
}
